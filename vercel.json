{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.jnegrete.dev" }],
      "destination": "https://jnegrete.dev/:path*",
      "permanent": true
    }
  ]
}
