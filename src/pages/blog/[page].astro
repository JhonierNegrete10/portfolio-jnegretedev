---
import Base from '../../layouts/Base.astro';
import type { GetStaticPaths, Page } from 'astro';
import { getUi } from '../../i18n/ui';
import { blogPagePath, blogPostPath, blogTopicPath, rssPath } from '../../i18n/routes';
import { getPublishedPosts, readingMinutes, type BlogEntry } from '../../lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts('es');
  const otherPosts = await getPublishedPosts('en');
  const otherTotalPages = Math.ceil(otherPosts.length / 10);
  return paginate(posts, { pageSize: 10 })
    .slice(1)
    .map((route) => ({
      ...route,
      props: { ...route.props, hasAlternate: route.props.page.currentPage <= otherTotalPages },
    }));
}) satisfies GetStaticPaths;

export interface Props {
  page: Page<BlogEntry>;
  hasAlternate: boolean;
}

const { page: pageData, hasAlternate } = Astro.props;
const lang = 'es' as const;
const t = getUi(lang);
const path = blogPagePath(lang, pageData.currentPage);
---

<Base
  lang={lang}
  page="blog"
  title={`${t.blog.title} — ${pageData.currentPage}`}
  description={t.meta.home.description}
  path={path}
  alternatePath={hasAlternate ? blogPagePath('en', pageData.currentPage) : undefined}
>
  <header class="blog-header">
    <h1>{t.blog.title}<span>.</span></h1><p>{pageData.currentPage} / {pageData.lastPage}</p>
  </header>
  <section class="all-posts" aria-label={t.blog.chronologicalAria}>
    <h2>{t.blog.allArticles}</h2>
    {
      pageData.data.map((post) => (
        <article class="flat-row">
          <a class="flat-title" href={blogPostPath(lang, post.id)}>
            {post.data.title}
          </a>
          <div class="flat-tags">
            {post.data.tags.map((tag) => (
              <a href={blogTopicPath(lang, tag)}>{tag}</a>
            ))}
          </div>
          <span class="flat-date">
            {post.data.date.toISOString().slice(0, 10)} · {readingMinutes(post.body)} {t.blog.readMinutes}
          </span>
        </article>
      ))
    }
    <nav class="pagination" aria-label={t.blog.paginationAria}>
      <a href={blogPagePath(lang, pageData.currentPage - 1)}>{t.blog.previousPage}</a>
      {
        pageData.currentPage < pageData.lastPage && (
          <a href={blogPagePath(lang, pageData.currentPage + 1)}>{t.blog.nextPage}</a>
        )
      }
    </nav>
  </section>
  <div class="footer-bar"><a href={rssPath(lang)}>{t.blog.rss}</a></div>
</Base>

<style>
  .blog-header {
    display: flex;
    gap: 12px;
    align-items: flex-end;
    justify-content: space-between;
    padding: 56px 24px 40px;
    border-bottom: 1px solid var(--color-border);
  }
  .blog-header h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 64px;
    line-height: 1;
    text-transform: uppercase;
  }
  .blog-header h1 span {
    color: var(--color-accent);
  }
  .blog-header p {
    margin: 0;
    color: var(--color-muted-dim);
    font-size: 11px;
  }
  .all-posts {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px 60px;
  }
  h2 {
    margin: 0 0 16px;
    font-size: 18px;
    text-transform: uppercase;
  }
  .flat-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 16px;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-top: 0;
    font-size: 12.5px;
  }
  .flat-row:first-of-type {
    border-top: 1px solid var(--color-border);
  }
  .flat-title {
    color: var(--color-text);
  }
  .flat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .flat-tags a {
    color: var(--color-accent);
  }
  .flat-date {
    color: var(--color-muted-dim);
    white-space: nowrap;
  }
  .pagination {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
  }
  .pagination a,
  .footer-bar a {
    padding: 10px 14px;
    border: 1px solid var(--color-border-strong);
    font-size: 11px;
    text-transform: uppercase;
  }
  .footer-bar {
    display: flex;
    justify-content: flex-end;
    padding: 32px 24px;
  }
  @media (max-width: 1059px) {
    .blog-header h1 {
      font-size: 40px;
    }
    .flat-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
</style>
