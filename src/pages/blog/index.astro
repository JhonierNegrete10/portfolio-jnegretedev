---
import BlogIndex from '../../components/blog/BlogIndex.astro';
import { PAGE_SIZE } from '../../lib/blog-constants';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts('es');
const lastPage = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
---

<BlogIndex
  lang="es"
  posts={posts.slice(0, PAGE_SIZE)}
  totalPosts={posts.length}
  currentPage={1}
  {lastPage}
  hasAlternate
/>
