---
import Base from '../../layouts/Base.astro';
import SeriesCard from '../../components/blog/SeriesCard.astro';
import { getUi } from '../../i18n/ui';
import { blogPagePath, blogPostPath, blogTopicPath, rssPath } from '../../i18n/routes';
import { getPublishedPosts, getSeriesWithPosts, readingMinutes } from '../../lib/blog';

const lang = 'es' as const;
const t = getUi(lang);
const path = blogPagePath(lang, 1);
const allPosts = await getPublishedPosts(lang);
const seriesGroups = await getSeriesWithPosts(lang);
const posts = allPosts.slice(0, 10);
const count = `${String(allPosts.length).padStart(3, '0')} ${t.blog.countSuffix}`;
---

<Base
  lang={lang}
  page="blog"
  title={t.blog.title}
  description={t.meta.home.description}
  path={path}
  alternatePath={blogPagePath('en', 1)}
>
  <header class="blog-header">
    <h1>{t.blog.title}<span>.</span></h1>
    <p>{count}</p>
  </header>

  {
    allPosts.length === 0 ? (
      <section class="empty">
        <h2>{t.blog.comingSoonTitle}</h2>
        <p>{t.blog.comingSoonBody}</p>
      </section>
    ) : (
      <>
        {seriesGroups.length > 0 && (
          <section class="series" aria-label={t.blog.seriesSectionAria}>
            {seriesGroups.map((group) => (
              <SeriesCard lang={lang} {...group} />
            ))}
          </section>
        )}
        <section class="all-posts" aria-label={t.blog.chronologicalAria}>
          <h2>{t.blog.allArticles}</h2>
          <div class="flat-list">
            {posts.map((post) => (
              <article class="flat-row">
                <a class="flat-title" href={blogPostPath(lang, post.id)}>
                  {post.data.title}
                </a>
                <div class="flat-tags">
                  {post.data.tags.map((tag) => (
                    <a href={blogTopicPath(lang, tag)}>{tag}</a>
                  ))}
                </div>
                <span class="flat-date">
                  {post.data.date.toISOString().slice(0, 10)} · {readingMinutes(post.body)} {t.blog.readMinutes}
                </span>
              </article>
            ))}
          </div>
          {allPosts.length > 10 && (
            <nav class="pagination" aria-label={t.blog.paginationAria}>
              <a href={blogPagePath(lang, 2)}>{t.blog.nextPage}</a>
            </nav>
          )}
        </section>
      </>
    )
  }

  <div class="footer-bar"><a href={rssPath(lang)}>{t.blog.rss}</a></div>
</Base>

<style>
  .blog-header {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
    justify-content: space-between;
    padding: 56px 24px 40px;
    border-bottom: 1px solid var(--color-border);
  }
  .blog-header h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    text-transform: uppercase;
  }
  .blog-header h1 span {
    color: var(--color-accent);
  }
  .blog-header p {
    margin: 0;
    color: var(--color-muted-dim);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .series {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 24px;
  }
  .all-posts {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 60px;
  }
  .all-posts h2 {
    margin: 0 0 16px;
    font-family: var(--font-sans);
    font-size: 18px;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .flat-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 16px;
    align-items: center;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-top: 0;
    font-size: 12.5px;
  }
  .flat-row:first-child {
    border-top: 1px solid var(--color-border);
  }
  .flat-title {
    color: var(--color-text);
  }
  .flat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .flat-tags a {
    color: var(--color-accent);
  }
  .flat-date {
    color: var(--color-muted-dim);
    font-size: 11px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pagination {
    display: flex;
    justify-content: flex-end;
    padding-top: 20px;
  }
  .pagination a,
  .footer-bar a {
    padding: 10px 14px;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .empty {
    padding: 64px 24px;
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }
  .empty h2 {
    margin: 0 0 12px;
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 24px;
    text-transform: uppercase;
  }
  .empty p {
    max-width: 480px;
    margin: 0 auto;
    color: var(--color-muted-soft);
    line-height: 1.8;
  }
  .footer-bar {
    display: flex;
    justify-content: flex-end;
    padding: 32px 24px;
  }
  @media (max-width: 1059px) {
    .blog-header h1 {
      font-size: 40px;
    }
    .flat-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }
  @media (max-width: 420px) {
    .blog-header,
    .series,
    .all-posts {
      padding-right: 16px;
      padding-left: 16px;
    }
  }
</style>
