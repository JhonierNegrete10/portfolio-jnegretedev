---
import Base from '../../../layouts/Base.astro';
import { getUi } from '../../../i18n/ui';
import { blogIndexPath, blogPostPath, blogSeriesPath } from '../../../i18n/routes';
import { getSeriesWithPosts, readingMinutes, type SeriesWithPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const groups = await getSeriesWithPosts('es');
  const otherIds = new Set((await getSeriesWithPosts('en')).map(({ id }) => id));
  return groups.map((group) => ({
    params: { serie: group.id },
    props: { group, hasAlternate: otherIds.has(group.id) },
  }));
}

export interface Props {
  group: SeriesWithPosts;
  hasAlternate: boolean;
}

const { group, hasAlternate } = Astro.props;
const lang = 'es' as const;
const t = getUi(lang);
const path = blogSeriesPath(lang, group.id);
const date = (value: Date) => value.toISOString().slice(0, 10);
---

<Base
  lang={lang}
  page="blog"
  title={group.definition.title[lang]}
  description={group.definition.description[lang]}
  path={path}
  alternatePath={hasAlternate ? blogSeriesPath('en', group.id) : undefined}
>
  <div class="hub">
    <a class="back" href={blogIndexPath(lang)}>← {t.blog.title}</a>
    <p class="eyebrow">{t.blog.seriesTitle}</p>
    <h1>{group.definition.title[lang]}</h1>
    <p class="description">{group.definition.description[lang]}</p>
    <ol>
      {
        group.baseGuide && (
          <li>
            <span class="number">00</span>
            <div>
              <>
                <a href={blogPostPath(lang, group.baseGuide.id)}>
                  {t.blog.baseGuide}: {group.baseGuide.data.title}
                </a>
                <p>{group.baseGuide.data.description}</p>
              </>
            </div>
            <span class="meta">
              {date(group.baseGuide.data.date)} · {readingMinutes(group.baseGuide.body)} {t.blog.readMinutes}
            </span>
          </li>
        )
      }
      {
        group.posts.map((post) => (
          <li>
            <span class="number">{String(post.data.seriesOrder).padStart(2, '0')}</span>
            <div>
              <>
                <a href={blogPostPath(lang, post.id)}>{post.data.title}</a>
                <p>{post.data.description}</p>
              </>
            </div>
            <span class="meta">
              {date(post.data.date)} · {readingMinutes(post.body)} {t.blog.readMinutes}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .hub {
    max-width: 1000px;
    margin: 0 auto;
    padding: 56px 24px 80px;
  }
  .back,
  .eyebrow,
  .meta {
    color: var(--color-muted-dim);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .back:hover {
    color: var(--color-accent);
    opacity: 1;
  }
  .eyebrow {
    margin: 40px 0 8px;
    color: var(--color-accent);
  }
  h1 {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: 48px;
    line-height: 1.05;
  }
  .description {
    max-width: 70ch;
    margin: 0 0 36px;
    color: var(--color-muted-soft);
    font-size: 15px;
    line-height: 1.8;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
  }
  li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 16px;
    padding: 20px;
    border-top: 1px solid var(--color-border);
  }
  li:first-child {
    border-top: 0;
  }
  .number {
    color: var(--color-muted-dim);
    font-family: var(--font-sans);
    font-weight: 700;
  }
  li a {
    color: var(--color-text);
    font-weight: 600;
  }
  li p {
    margin: 6px 0 0;
    color: var(--color-muted);
    font-size: 12.5px;
    line-height: 1.6;
  }
  .meta {
    text-align: right;
    white-space: nowrap;
  }
  @media (max-width: 700px) {
    h1 {
      font-size: 34px;
    }
    li {
      grid-template-columns: 28px minmax(0, 1fr);
    }
    .meta {
      grid-column: 1 / -1;
      text-align: left;
    }
  }
</style>
