---
import PostPage from '../../../components/blog/PostPage.astro';
import { getPublishedPosts, getTranslation, type BlogEntry } from '../../../lib/blog';

export async function getStaticPaths() {
  return Promise.all(
    (await getPublishedPosts('en')).map(async (entry) => ({
      params: { slug: entry.id },
      props: { entry, translatedSlug: (await getTranslation(entry))?.id },
    })),
  );
}

const { entry, translatedSlug } = Astro.props as { entry: BlogEntry; translatedSlug?: string };
---

<PostPage lang="en" {entry} {translatedSlug} />
