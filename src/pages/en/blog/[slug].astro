---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';
import LimitsBox from '../../../components/blog/LimitsBox.astro';
import PostMeta from '../../../components/blog/PostMeta.astro';
import PrevNext from '../../../components/blog/PrevNext.astro';
import SeriesNav from '../../../components/blog/SeriesNav.astro';
import TableOfContents from '../../../components/blog/TableOfContents.astro';
import { blogPostPath } from '../../../i18n/routes';
import { getPublishedPosts, getSeriesPosts, getTranslation, readingMinutes, type BlogEntry } from '../../../lib/blog';
import { getSeries } from '../../../data/series';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('en');
  return Promise.all(
    posts.map(async (entry) => ({
      params: { slug: entry.id },
      props: { entry, translatedSlug: (await getTranslation(entry))?.id },
    })),
  );
}

export interface Props {
  entry: BlogEntry;
  translatedSlug?: string;
}

const { entry, translatedSlug } = Astro.props;
const { Content, headings } = await render(entry);
const lang = 'en' as const;
const path = blogPostPath(lang, entry.id);
const alternatePath = translatedSlug ? blogPostPath('es', translatedSlug) : undefined;
const siteUrl = Astro.site ?? new URL('https://jnegrete.dev');
const ownUrl = new URL(path, siteUrl).toString();
const ogImagePath = entry.data.cover?.src.src ?? `/og/${entry.id}.png`;
const seriesDefinition = entry.data.series ? getSeries(entry.data.series) : undefined;
const seriesPosts = entry.data.series ? await getSeriesPosts(entry.data.series, lang) : [];
const article = {
  publishedTime: entry.data.date,
  modifiedTime: entry.data.updated ?? entry.data.date,
  tags: entry.data.tags,
  ogImage: ogImagePath,
  ogImageWidth: entry.data.cover?.src.width,
  ogImageHeight: entry.data.cover?.src.height,
  canonicalOverride: entry.data.canonical,
};
const post = {
  url: ownUrl,
  canonical: entry.data.canonical ?? ownUrl,
  title: entry.data.title,
  description: entry.data.description,
  publishedTime: entry.data.date,
  modifiedTime: entry.data.updated ?? entry.data.date,
  lang,
  tags: entry.data.tags,
  image: new URL(ogImagePath, siteUrl).toString(),
  ...(entry.data.series &&
    seriesDefinition && { series: { id: entry.data.series, name: seriesDefinition.title[lang] } }),
};
---

<Base
  lang={lang}
  page="blog"
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  alternatePath={alternatePath}
  isBlogPost
  translatedSlug={translatedSlug}
  article={article}
  post={post}
>
  <article class="post">
    <header class="article-top">
      <Breadcrumbs
        lang={lang}
        title={entry.data.title}
        series={entry.data.series && seriesDefinition
          ? { id: entry.data.series, title: seriesDefinition.title[lang] }
          : undefined}
      />
      <PostMeta
        lang={lang}
        date={entry.data.date}
        updated={entry.data.updated}
        minutes={readingMinutes(entry.body)}
        seriesTitle={seriesDefinition?.title[lang]}
        seriesOrder={entry.data.seriesOrder}
        seriesTotal={seriesPosts.length}
      />
      <h1>{entry.data.title}</h1>
    </header>

    <div class="two-col">
      <div class="post__body"><Content /></div>
      <aside class="rail">
        <TableOfContents lang={lang} headings={headings} />
        {
          seriesDefinition && (
            <SeriesNav lang={lang} definition={seriesDefinition} posts={seriesPosts} currentSlug={entry.id} />
          )
        }
        <LimitsBox
          lang={lang}
          prerequisites={entry.data.prerequisites}
          limits={entry.data.limits}
          lastUpdated={entry.data.updated ?? entry.data.date}
        />
      </aside>
    </div>

    <PrevNext lang={lang} entry={entry} seriesPosts={seriesPosts} seriesDefinition={seriesDefinition} />
  </article>
</Base>

<style>
  .post {
    padding-bottom: 80px;
  }
  .article-top,
  .two-col {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-right: 24px;
    padding-left: 24px;
  }
  .article-top {
    padding-top: 40px;
  }
  h1 {
    max-width: 900px;
    margin: 0 0 28px;
    font-family: var(--font-sans);
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 720px) 300px;
    gap: 48px;
    align-items: start;
    justify-content: space-between;
    padding-bottom: 20px;
  }
  .post__body {
    min-width: 0;
    color: var(--color-muted-soft);
    font-size: 15px;
    line-height: 1.9;
  }
  .post__body :global(h2),
  .post__body :global(h3) {
    margin-top: 2em;
    color: var(--color-text);
    font-family: var(--font-sans);
    scroll-margin-top: 90px;
  }
  .post__body :global(h2:first-child) {
    margin-top: 0;
  }
  .post__body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .post__body :global(code) {
    padding: 2px 6px;
    background: var(--color-border);
    font-size: 0.9em;
  }
  .post__body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: #1c1c1e;
  }
  .post__body :global(.expressive-code) {
    max-width: 100%;
    overflow: hidden;
  }
  .rail {
    position: sticky;
    top: 82px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  @media (max-width: 1059px) {
    h1 {
      font-size: 30px;
    }
    .two-col {
      grid-template-columns: minmax(0, 1fr);
    }
    .rail {
      position: static;
    }
  }
  @media (max-width: 420px) {
    .article-top,
    .two-col {
      padding-right: 16px;
      padding-left: 16px;
    }
  }
</style>
