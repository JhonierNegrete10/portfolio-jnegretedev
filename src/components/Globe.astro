---
/**
 * Animated canvas globe for the Home hero — ported from the vanilla JS in
 * reference/Portafolio 5a - Sitio.dc.html (componentDidMount / draw()).
 *
 * Accessibility (design.md Decision 10 / spec "Animaciones accesibles"):
 * - prefers-reduced-motion: reduce -> a single static frame is painted and
 *   no requestAnimationFrame loop is started at all.
 * - IntersectionObserver + visibilitychange pause/resume the rAF loop when
 *   the globe scrolls out of view or the tab is hidden.
 * - The wrapper carries role="img" + aria-label; all decorative children
 *   (canvas, rings, orbit dots) are aria-hidden.
 */
import type { Lang } from '../i18n/routes';
import { getUiExtra } from '../i18n/ui';
import { profile } from '../data/profile';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tExtra = getUiExtra(lang);
const { latLabel, lonLabel } = profile.coordinates;
---

<div class="globe-cell">
  <div class="globe-caption globe-caption--top" aria-hidden="true">{tExtra.home.satLabel}</div>
  <div class="globe-caption globe-caption--bottom" aria-hidden="true">{latLabel}<br />{lonLabel}</div>

  <div class="globe-stage" role="img" aria-label={tExtra.home.globeAriaLabel}>
    <div class="globe-ring" aria-hidden="true"></div>
    <canvas data-globe-canvas width="600" height="600" class="globe-canvas" aria-hidden="true"></canvas>
    <div class="orbit orbit--outer" aria-hidden="true">
      <span class="orbit-dot orbit-dot--white"></span>
    </div>
    <div class="orbit orbit--inner" aria-hidden="true">
      <span class="orbit-dot orbit-dot--accent"></span>
    </div>
  </div>
</div>

<style>
  .globe-cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 460px;
    overflow: hidden;
  }

  .globe-caption {
    position: absolute;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: #5c5c58;
    text-transform: uppercase;
  }

  .globe-caption--top {
    top: 16px;
    left: 20px;
  }

  .globe-caption--bottom {
    bottom: 16px;
    right: 20px;
    text-align: right;
    line-height: 1.8;
  }

  .globe-stage {
    position: relative;
    width: 300px;
    height: 300px;
    perspective: 900px;
  }

  .globe-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 92, 53, 0.45);
    box-shadow:
      0 0 60px rgba(255, 92, 53, 0.18),
      inset 0 0 40px rgba(255, 92, 53, 0.08);
  }

  .globe-canvas {
    position: absolute;
    inset: 0;
    width: 300px;
    height: 300px;
  }

  .orbit {
    position: absolute;
    border-radius: 50%;
  }

  .orbit--outer {
    inset: -34px;
    border: 1px dashed rgba(236, 236, 234, 0.18);
    animation: orbit 12s linear infinite;
  }

  .orbit--inner {
    inset: -70px;
    border: 1px dashed rgba(255, 92, 53, 0.14);
    animation: spinSlow 26s linear infinite;
  }

  .orbit-dot {
    position: absolute;
    border-radius: 50%;
  }

  .orbit-dot--white {
    top: -4px;
    left: 50%;
    width: 8px;
    height: 8px;
    background: #ececea;
    box-shadow: 0 0 12px rgba(236, 236, 234, 0.9);
  }

  .orbit-dot--accent {
    bottom: 6px;
    left: 18%;
    width: 6px;
    height: 6px;
    background: #ff5c35;
    box-shadow: 0 0 10px rgba(255, 92, 53, 0.9);
  }
</style>

<script>
  // Coarse continent polygons (lon, lat) — stylized silhouettes, ported 1:1
  // from the reference HTML's componentDidMount().
  const POLYS: [number, number][][] = [
    [
      [-165, 65], [-155, 71], [-130, 70], [-110, 73], [-85, 70], [-75, 62], [-55, 52], [-65, 45], [-75, 40],
      [-76, 35], [-81, 30], [-81, 25], [-90, 29], [-97, 26], [-97, 20], [-105, 20], [-110, 23], [-115, 29],
      [-124, 40], [-125, 48], [-135, 58], [-155, 58],
    ],
    [
      [-97, 20], [-90, 15], [-83, 9], [-79, 8], [-83, 11], [-88, 13], [-92, 15], [-97, 17],
    ],
    [
      [-79, 9], [-71, 12], [-60, 8], [-50, 0], [-35, -8], [-39, -15], [-48, -25], [-53, -34], [-58, -39],
      [-65, -41], [-65, -47], [-68, -52], [-71, -54], [-73, -46], [-71, -37], [-71, -30], [-70, -18], [-75, -15],
      [-81, -6], [-80, 0], [-77, 7],
    ],
    [
      [-17, 15], [-16, 22], [-10, 30], [-5, 36], [10, 37], [20, 32], [32, 31], [34, 28], [38, 18], [43, 11],
      [51, 12], [45, 0], [40, -10], [35, -20], [33, -29], [25, -34], [18, -33], [12, -18], [9, -1], [9, 5],
      [-8, 4], [-13, 9],
    ],
    [
      [-10, 36], [-10, 43], [0, 50], [5, 58], [10, 63], [15, 68], [25, 71], [40, 67], [60, 69], [75, 72],
      [100, 77], [140, 72], [160, 70], [178, 66], [178, 64], [162, 60], [160, 53], [142, 54], [140, 43],
      [130, 42], [122, 39], [122, 37], [121, 31], [115, 22], [108, 18], [105, 10], [103, 1], [100, 7], [98, 12],
      [94, 17], [90, 22], [87, 21], [80, 15], [77, 8], [73, 20], [67, 24], [58, 25], [57, 27], [50, 29],
      [48, 30], [52, 25], [58, 22], [58, 17], [52, 16], [45, 12], [43, 15], [38, 20], [34, 28], [32, 31],
      [27, 36], [26, 40], [20, 40], [15, 42], [12, 44], [3, 43], [-2, 36],
    ],
    [
      [114, -22], [122, -17], [130, -12], [136, -12], [142, -11], [146, -19], [153, -27], [150, -37],
      [140, -38], [131, -32], [124, -33], [115, -34], [113, -26],
    ],
    [
      [-58, 76], [-30, 83], [-20, 70], [-42, 60], [-52, 65], [-55, 70],
    ],
  ];

  interface GlobePoint {
    lon: number;
    lat: number;
    land: boolean;
  }

  function inPoly(lon: number, lat: number, poly: [number, number][]): boolean {
    let inside = false;
    for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
      const [xi, yi] = poly[i];
      const [xj, yj] = poly[j];
      if (yi > lat !== yj > lat && lon < ((xj - xi) * (lat - yi)) / (yj - yi) + xi) inside = !inside;
    }
    return inside;
  }

  function buildPoints(): GlobePoint[] {
    const pts: GlobePoint[] = [];
    for (let lat = -60; lat <= 84; lat += 3.2) {
      const step = 3.2 / Math.max(0.25, Math.cos((lat * Math.PI) / 180));
      for (let lon = -180; lon < 180; lon += step) {
        const land = POLYS.some((p) => inPoly(lon, lat, p));
        pts.push({ lon: (lon * Math.PI) / 180, lat: (lat * Math.PI) / 180, land });
      }
    }
    return pts;
  }

  function setupGlobe(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pts = buildPoints();
    const tilt = -0.35;
    const ct = Math.cos(tilt);
    const st = Math.sin(tilt);
    const W = canvas.width;
    const R = W * 0.47;
    const cx = W / 2;
    const cy = W / 2;

    function drawFrame(t: number) {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, W);
      const rot = t * 0.00012;
      for (const p of pts) {
        const lon = p.lon + rot;
        const cl = Math.cos(p.lat);
        const x = cl * Math.sin(lon);
        const y = Math.sin(p.lat);
        const z = cl * Math.cos(lon);
        const y2 = y * ct - z * st;
        const z2 = y * st + z * ct;
        if (z2 <= 0.02) continue;
        const px = cx + x * R;
        const py = cy - y2 * R;
        const fade = Math.min(1, z2 * 1.6);
        if (p.land) {
          ctx.fillStyle = `rgba(255,92,53,${(0.25 + 0.7 * fade).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(px, py, 2.4 + 1.2 * z2, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillStyle = `rgba(255,92,53,${(0.05 + 0.09 * fade).toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(px, py, 1.1, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }

    // Always paint one frame up front. Under reduced motion this is the
    // final state — no rAF loop is ever started.
    drawFrame(0);
    if (reduceMotion) return;

    let rafId: number | null = null;

    function loop(t: number) {
      drawFrame(t);
      rafId = requestAnimationFrame(loop);
    }

    function start() {
      if (rafId !== null) return;
      rafId = requestAnimationFrame(loop);
    }

    function stop() {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && document.visibilityState === 'visible') start();
          else stop();
        }
      },
      { threshold: 0.01 },
    );
    observer.observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        stop();
        return;
      }
      const rect = canvas.getBoundingClientRect();
      const inView = rect.bottom > 0 && rect.top < window.innerHeight;
      if (inView) start();
    });
  }

  function initGlobes() {
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-globe-canvas]').forEach(setupGlobe);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobes);
  } else {
    initGlobes();
  }
</script>
