---
import type { MarkdownHeading } from 'astro';
import { getUi } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';

export interface Props {
  lang: Lang;
  headings: MarkdownHeading[];
}

const { lang, headings } = Astro.props;
const t = getUi(lang);
const entries = headings.filter(({ depth }) => depth === 2 || depth === 3);
---

{
  entries.length > 0 && (
    <nav class="rail-box" aria-label={t.blog.toc}>
      <details open>
        <summary>{t.blog.toc}</summary>
        <ol>
          {entries.map((heading) => (
            <li class:list={{ nested: heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}

<!-- Keep desktop expanded, but start the mobile disclosure closed. Running
     immediately after the element avoids waiting for hydration. -->
<script is:inline>
  const details = document.currentScript?.previousElementSibling?.querySelector('details');
  if (details && matchMedia('(max-width: 1059px)').matches) details.removeAttribute('open');
</script>

<style>
  .rail-box {
    border: 1px solid var(--color-border);
    padding: 18px;
  }

  summary {
    margin: 0 0 12px;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 12px;
    letter-spacing: 0.1em;
    list-style: none;
    text-transform: uppercase;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    float: right;
    content: '+';
  }

  details[open] summary::after {
    content: '−';
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li.nested {
    padding-left: 12px;
  }

  a {
    color: var(--color-muted-soft);
    font-size: 12.5px;
  }

  @media (min-width: 1060px) {
    summary {
      cursor: pointer;
    }

    summary::after {
      display: none;
    }
  }
</style>
