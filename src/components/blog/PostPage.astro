---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import LimitsBox from './LimitsBox.astro';
import PostMeta from './PostMeta.astro';
import PrevNext from './PrevNext.astro';
import SeriesNav from './SeriesNav.astro';
import TableOfContents from './TableOfContents.astro';
import { blogPostPath, otherLang, type Lang } from '../../i18n/routes';
import { getSeriesWithPosts, readingMinutes, type BlogEntry } from '../../lib/blog';

export interface Props {
  lang: Lang;
  entry: BlogEntry;
  translatedSlug?: string;
}

const { lang, entry, translatedSlug } = Astro.props;
const { Content, headings } = await render(entry);
const path = blogPostPath(lang, entry.id);
const alternatePath = translatedSlug ? blogPostPath(otherLang(lang), translatedSlug) : undefined;
const siteUrl = Astro.site ?? new URL('https://jnegrete.dev');
const ownUrl = new URL(path, siteUrl).toString();
const ogImagePath = entry.data.cover?.src.src ?? `/og/${entry.id}.png`;
const seriesGroup = entry.data.series
  ? (await getSeriesWithPosts(lang)).find((group) => group.id === entry.data.series)
  : undefined;
const seriesDefinition = seriesGroup?.definition;
const seriesPosts = seriesGroup?.posts ?? [];
const seriesPosition = seriesPosts.findIndex((post) => post.id === entry.id) + 1;
const article = {
  publishedTime: entry.data.date,
  modifiedTime: entry.data.updated ?? entry.data.date,
  tags: entry.data.tags,
  ogImage: ogImagePath,
  ogImageWidth: entry.data.cover?.src.width,
  ogImageHeight: entry.data.cover?.src.height,
  canonicalOverride: entry.data.canonical,
};
const post = {
  url: ownUrl,
  canonical: entry.data.canonical ?? ownUrl,
  title: entry.data.title,
  description: entry.data.description,
  publishedTime: entry.data.date,
  modifiedTime: entry.data.updated ?? entry.data.date,
  lang,
  tags: entry.data.tags,
  image: new URL(ogImagePath, siteUrl).toString(),
  ...(entry.data.series &&
    seriesDefinition && {
      series: { id: entry.data.series, name: seriesDefinition.title[lang] },
    }),
};
---

<Base
  lang={lang}
  page="blog"
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  alternatePath={alternatePath}
  isBlogPost
  translatedSlug={translatedSlug}
  article={article}
  post={post}
>
  <article class="post">
    <header class="article-top">
      <Breadcrumbs
        lang={lang}
        title={entry.data.title}
        series={entry.data.series && seriesDefinition
          ? { id: entry.data.series, title: seriesDefinition.title[lang] }
          : undefined}
      />
      <PostMeta
        lang={lang}
        date={entry.data.date}
        updated={entry.data.updated}
        minutes={readingMinutes(entry.body)}
        seriesTitle={seriesDefinition?.title[lang]}
        seriesPosition={seriesPosition || undefined}
        seriesTotal={seriesPosts.length + (seriesGroup?.planned.length ?? 0)}
        tags={entry.data.tags}
      />
      <h1>{entry.data.title}</h1>
    </header>

    <div class="two-col">
      <div class="rail rail--top"><TableOfContents lang={lang} headings={headings} /></div>
      <div class="post__body"><Content /></div>
      <div class="rail rail--bottom">
        {
          seriesDefinition && (
            <SeriesNav lang={lang} definition={seriesDefinition} posts={seriesPosts} currentSlug={entry.id} />
          )
        }
        <LimitsBox
          lang={lang}
          prerequisites={entry.data.prerequisites}
          limits={entry.data.limits}
          lastUpdated={entry.data.updated ?? entry.data.date}
        />
      </div>
    </div>

    <PrevNext lang={lang} entry={entry} seriesPosts={seriesPosts} seriesDefinition={seriesDefinition} />
  </article>
</Base>

<style>
  .post {
    padding-bottom: 80px;
  }
  .article-top,
  .two-col {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding-right: 24px;
    padding-left: 24px;
  }
  .article-top {
    padding-top: 40px;
  }
  h1 {
    max-width: 900px;
    margin: 0 0 28px;
    font-family: var(--font-sans);
    font-size: 44px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .two-col {
    display: grid;
    grid-template-areas:
      'body rail-top'
      'body rail-bottom';
    grid-template-columns: minmax(0, 720px) 300px;
    gap: 20px 48px;
    align-items: start;
    justify-content: space-between;
    padding-bottom: 20px;
  }
  .post__body {
    grid-area: body;
    min-width: 0;
    color: var(--color-muted-soft);
    font-size: 15px;
    line-height: 1.9;
  }
  .post__body :global(h2),
  .post__body :global(h3) {
    margin-top: 2em;
    color: var(--color-text);
    font-family: var(--font-sans);
    scroll-margin-top: 90px;
  }
  .post__body :global(h2:first-child) {
    margin-top: 0;
  }
  .post__body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .post__body :global(code) {
    padding: 2px 6px;
    background: var(--color-border);
    font-size: 0.9em;
  }
  .post__body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: #1c1c1e;
  }
  .post__body :global(.expressive-code) {
    max-width: 100%;
    overflow: hidden;
  }
  .rail {
    position: sticky;
    top: 82px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    max-height: calc(100vh - 82px - 24px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .rail--top {
    grid-area: rail-top;
  }
  .rail--bottom {
    position: static;
    grid-area: rail-bottom;
    max-height: none;
    overflow: visible;
  }
  @media (max-width: 1059px) {
    h1 {
      font-size: 30px;
    }
    .two-col {
      grid-template-areas:
        'rail-top'
        'body'
        'rail-bottom';
      grid-template-columns: minmax(0, 1fr);
    }
    .rail {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }
  @media (max-width: 420px) {
    .article-top,
    .two-col {
      padding-right: 16px;
      padding-left: 16px;
    }
  }
</style>
