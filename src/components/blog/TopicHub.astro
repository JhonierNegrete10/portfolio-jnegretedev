---
import Base from '../../layouts/Base.astro';
import { getUi } from '../../i18n/ui';
import { blogIndexPath, blogPostPath, blogTopicPath, otherLang, type Lang } from '../../i18n/routes';
import { readingMinutes, type BlogEntry } from '../../lib/blog';

export interface Props {
  lang: Lang;
  tag: string;
  posts: BlogEntry[];
  hasAlternate: boolean;
}

const { lang, tag, posts, hasAlternate } = Astro.props;
const t = getUi(lang);
const path = blogTopicPath(lang, tag);
const count = `${String(posts.length).padStart(3, '0')} ${t.blog.countSuffix}`;
---

<Base
  lang={lang}
  page="blog"
  title={`${t.blog.topicTitle}: ${tag}`}
  description={`${t.blog.allArticles}: ${tag}`}
  path={path}
  alternatePath={hasAlternate ? blogTopicPath(otherLang(lang), tag) : undefined}
  noindex={posts.length === 1}
>
  <div class="hub">
    <a class="back" href={blogIndexPath(lang)}>← {t.blog.title}</a>
    <div class="heading">
      <div>
        <p class="eyebrow">{t.blog.topicTitle}</p>
        <h1>{tag}</h1>
      </div>
      <p class="count">{count}</p>
    </div>
    <ol>
      {
        posts.map((post) => (
          <li>
            <a href={blogPostPath(lang, post.id)}>{post.data.title}</a>
            <span>
              {post.data.date.toISOString().slice(0, 10)} · {readingMinutes(post.body)} {t.blog.readMinutes}
            </span>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .hub {
    max-width: 900px;
    margin: 0 auto;
    padding: 56px 24px 80px;
  }
  .heading {
    display: flex;
    gap: 20px;
    align-items: end;
    justify-content: space-between;
  }
  .back,
  .eyebrow,
  .count,
  li span {
    color: var(--color-muted-dim);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .eyebrow {
    margin: 40px 0 8px;
    color: var(--color-accent);
  }
  .count {
    margin-bottom: 36px;
  }
  h1 {
    margin: 0 0 36px;
    font-family: var(--font-sans);
    font-size: 48px;
    text-transform: uppercase;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 20px;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
  }
  li a {
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
  }
  li p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.7;
  }
  li span {
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .heading {
      display: block;
    }
    h1 {
      margin-bottom: 8px;
      font-size: 34px;
    }
    .count {
      margin: 0 0 36px;
    }
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
