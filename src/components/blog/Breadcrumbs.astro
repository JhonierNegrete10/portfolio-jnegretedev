---
import { getUi } from '../../i18n/ui';
import { blogIndexPath, blogSeriesPath, type Lang } from '../../i18n/routes';

export interface Props {
  lang: Lang;
  title: string;
  series?: { id: string; title: string };
}

const { lang, title, series } = Astro.props;
const t = getUi(lang);
---

<nav class="breadcrumbs" aria-label={t.blog.breadcrumbsAria} data-blog-block="breadcrumbs">
  <ol>
    <li><a href={blogIndexPath(lang)}>{t.blog.title}</a></li>
    {
      series && (
        <li>
          <a href={blogSeriesPath(lang, series.id)}>{series.title}</a>
        </li>
      )
    }
    <li aria-current="page">{title}</li>
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 18px;
    color: var(--color-muted-dim);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li:not(:last-child)::after {
    content: '›';
    margin-left: 6px;
    color: var(--color-muted-dim);
  }

  a {
    color: var(--color-muted);
  }

  a:hover {
    color: var(--color-accent);
    opacity: 1;
  }
</style>
