---
import { getUi } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';
import { blogTopicPath } from '../../i18n/routes';

export interface Props {
  lang: Lang;
  date: Date;
  updated?: Date;
  minutes: number;
  seriesTitle?: string;
  seriesPosition?: number;
  seriesTotal?: number;
  tags: string[];
}

const { lang, date, updated, minutes, seriesTitle, seriesPosition, seriesTotal, tags } = Astro.props;
const t = getUi(lang);
const iso = (value: Date) => value.toISOString().slice(0, 10);
---

<div class="post-meta">
  {
    seriesTitle && (
      <span>
        <strong>{t.blog.seriesLabel}</strong> {seriesTitle}
      </span>
    )
  }
  {
    seriesPosition && seriesTotal && (
      <span>
        <strong>{t.blog.pieceLabel}</strong> {seriesPosition} {t.blog.ofLabel} {seriesTotal}
      </span>
    )
  }
  <span><strong>{t.blog.publishedOn}</strong> {iso(date)}</span>
  {
    updated && (
      <span>
        <strong>{t.blog.updatedOn}</strong> {iso(updated)}
      </span>
    )
  }
  <span><strong>{minutes}</strong> {t.blog.readMinutes}</span>
  {
    tags.map((tag) => (
      <span class="tag">
        · <a href={blogTopicPath(lang, tag)}>{tag}</a>
      </span>
    ))
  }
</div>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-bottom: 22px;
    color: var(--color-muted-dim);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  strong {
    color: var(--color-muted-soft);
    font-weight: 500;
  }

  .tag {
    color: var(--color-muted-dim);
  }

  .tag a {
    color: var(--color-accent);
  }
</style>
