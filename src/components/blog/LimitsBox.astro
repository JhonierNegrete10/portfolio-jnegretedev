---
import { getUi } from '../../i18n/ui';
import type { Lang } from '../../i18n/routes';

export interface Props {
  lang: Lang;
  prerequisites?: string[];
  limits?: string[];
  lastUpdated: Date;
}

const { lang, prerequisites = [], limits = [], lastUpdated } = Astro.props;
const t = getUi(lang);
---

<section class="limits" data-blog-block="limits" aria-labelledby="limits-title">
  <h2 id="limits-title">{t.blog.limitsTitle}</h2>
  {
    prerequisites.length > 0 && (
      <div>
        <h3>{t.blog.prerequisitesTitle}</h3>
        <ul>
          {prerequisites.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
  {
    limits.length > 0 && (
      <div>
        <h3>{t.blog.limitationsTitle}</h3>
        <ul>
          {limits.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
  <p>{t.blog.updatedOn}: {lastUpdated.toISOString().slice(0, 10)}</p>
</section>

<style>
  .limits {
    padding: 18px;
    border: 1px solid var(--color-border);
    background: rgba(255, 92, 53, 0.05);
  }

  h2,
  h3 {
    color: var(--color-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 12px;
  }

  h3 {
    margin: 14px 0 6px;
    font-size: 10px;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    margin: 0 0 10px;
    padding: 0;
  }

  li {
    position: relative;
    padding-left: 14px;
    color: var(--color-muted-soft);
    font-size: 12.5px;
    line-height: 1.6;
  }

  li::before {
    position: absolute;
    left: 0;
    color: var(--color-muted-dim);
    content: '—';
  }

  p {
    margin: 14px 0 0;
    color: var(--color-muted-dim);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
