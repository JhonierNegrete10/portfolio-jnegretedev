---
import { blogIndexPath, blogSeriesPath, type Lang } from '../i18n/routes';
import { profile } from '../data/profile';
import { seriesHubPagesPublished } from '../data/series';
import type { StructuredBlogPost } from '../lib/blog-metadata';

export interface Props {
  lang: Lang;
  post?: StructuredBlogPost;
}

const { lang, post } = Astro.props;

const siteUrl = 'https://jnegrete.dev';

const [locality, country] = profile.location.es.split(', ');

const graphNodes: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: profile.name,
    url: siteUrl,
    email: profile.email,
    jobTitle: profile.tagline[lang],
    description: profile.tagline[lang],
    sameAs: [profile.links.github.url, profile.links.linkedin.url],
    ...(locality &&
      country && {
        address: {
          '@type': 'PostalAddress',
          addressLocality: locality,
          addressCountry: country,
        },
      }),
  },
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: `${profile.name} — Portfolio`,
    url: siteUrl,
    inLanguage: ['es', 'en'],
  },
];

if (post) {
  graphNodes.push({
    '@type': 'BlogPosting',
    '@id': `${post.url}#article`,
    headline: post.title,
    description: post.description,
    datePublished: post.publishedTime.toISOString(),
    dateModified: post.modifiedTime.toISOString(),
    inLanguage: post.lang,
    author: { '@id': `${siteUrl}/#person` },
    publisher: { '@id': `${siteUrl}/#person` },
    image: post.image,
    mainEntityOfPage: post.canonical,
    keywords: post.tags.join(', '),
    ...(post.series && seriesHubPagesPublished
      ? {
          isPartOf: {
            '@type': 'CreativeWorkSeries',
            name: post.series.name,
            url: new URL(blogSeriesPath(post.lang, post.series.id), `${siteUrl}/`).toString(),
          },
        }
      : {}),
  });

  const breadcrumbItems = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Blog',
      item: new URL(blogIndexPath(post.lang), `${siteUrl}/`).toString(),
    },
  ];

  if (post.series && seriesHubPagesPublished) {
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: 2,
      name: post.series.name,
      item: new URL(blogSeriesPath(post.lang, post.series.id), `${siteUrl}/`).toString(),
    });
  }

  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name: post.title,
    item: post.url,
  });

  graphNodes.push({
    '@type': 'BreadcrumbList',
    '@id': `${post.url}#breadcrumb`,
    itemListElement: breadcrumbItems,
  });
}

const graph = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};

const jsonLd = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={jsonLd} />
