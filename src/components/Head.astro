---
import type { Lang } from '../i18n/routes';
import { rssPath } from '../i18n/routes';
import { profile } from '../data/profile';
import type { ArticleMetadata, StructuredBlogPost } from '../lib/blog-metadata';
import StructuredData from './StructuredData.astro';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  lang: Lang;
  /** Page-specific title. The site name is appended automatically. */
  title: string;
  description: string;
  /** Current page path, trailing slash included (e.g. "/proyectos/"). */
  path: string;
  /**
   * Equivalent path in the other language, when a true content equivalent
   * exists. Omit for e.g. a blog post with no translation — hreflang for
   * that language is then skipped rather than pointing at different content.
   */
  alternatePath?: string;
  /** Set true on the 404 page. */
  noindex?: boolean;
  article?: ArticleMetadata;
  post?: StructuredBlogPost;
}

const { lang, title, description, path, alternatePath, noindex = false, article, post } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://jnegrete.dev');
const ownUrl = new URL(path, siteUrl).toString();
const canonical = article?.canonicalOverride ?? ownUrl;
const ogImage = new URL(article?.ogImage ?? '/og.png', siteUrl).toString();
const ogImageWidth = article?.ogImageWidth ?? 1200;
const ogImageHeight = article?.ogImageHeight ?? 630;

const esPath = lang === 'es' ? path : alternatePath;
const enPath = lang === 'en' ? path : alternatePath;
const xDefaultPath = esPath ?? path;

const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';
const ogLocaleAlternate = lang === 'es' ? 'en_US' : 'es_CO';

const fullTitle = `${title} — ${profile.name}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="canonical" href={canonical} />
{esPath && <link rel="alternate" hreflang="es" href={new URL(esPath, siteUrl).toString()} />}
{enPath && <link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).toString()} />}
<link rel="alternate" hreflang="x-default" href={new URL(xDefaultPath, siteUrl).toString()} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${profile.name} — Blog (${lang.toUpperCase()})`}
  href={rssPath(lang)}
/>

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
{article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Icons -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta name="generator" content={Astro.generator} />

<StructuredData lang={lang} post={post} />

<!-- Vercel Web Analytics: componente oficial @vercel/analytics/astro (v1.4.0+),
     el método canónico para Astro 5. Inyecta el script con el path ofuscado y
     resiliente a adblockers; requiere habilitar Web Analytics en el dashboard
     del proyecto Vercel para que /_vercel/insights/* deje de dar 404. -->
<Analytics />

<!-- Vercel Speed Insights (script HTML para sitio estático; requiere estar
     habilitado en el dashboard del proyecto para registrar datos). -->
<script is:inline>
  window.si =
    window.si ||
    function () {
      (window.siq = window.siq || []).push(arguments);
    };
</script>
<script is:inline defer src="/_vercel/speed-insights/script.js"></script>
